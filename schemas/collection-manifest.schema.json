{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mehul0810/icon-library/blob/main/schemas/collection-manifest.schema.json",
  "title": "Icon Library collection manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "name", "description", "version", "license", "source", "variants", "icons"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "license": { "$ref": "#/$defs/linkMetadata" },
    "source": {
      "allOf": [
        { "$ref": "#/$defs/linkMetadata" },
        {
          "type": "object",
          "required": ["revision"],
          "properties": { "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" } }
        }
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "label"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "iconCount": { "type": "integer", "minimum": 0 },
          "coreCompatible": { "type": "boolean", "default": true },
          "defaultEnabled": { "type": "boolean", "default": true }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "label", "iconCount"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "iconCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/icon" }
    }
  },
  "$defs": {
    "linkMetadata": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coreIconName", "label", "variant", "categories", "keywords", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "coreIconName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:[-_][a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "categories": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string", "pattern": "^[^./][^\\\\]*\\.svg$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
