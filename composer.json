{
    "name": "mehul0810/icon-library",
    "description": "Curated and custom icon collections for the WordPress Icon block.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php scripts/lint.php",
        "manifests": "@php scripts/validate-manifests.php",
        "test": "phpunit",
        "cs": "phpcs",
        "package": "@php scripts/package-release.php",
		"smoke": "@php scripts/runtime-smoke.php",
        "check": [
            "@lint",
            "@manifests",
            "@test",
            "@cs"
        ]
    }
}
